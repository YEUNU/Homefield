#!/usr/bin/env bash
# Protect the public repo: block commits of secrets and data files.
set -euo pipefail
fail=0
files=$(git diff --cached --name-only --diff-filter=ACM)
for f in $files; do
  case "$f" in
    .env|*/.env|.env.*) [ "$f" = ".env.example" ] || { echo "Blocked: $f (secret file)"; fail=1; } ;;
    data/*) echo "Blocked: $f (data/ must not be committed)"; fail=1 ;;
    *.pem|*.key|*.p12) echo "Blocked: $f (key file)"; fail=1 ;;
  esac
done
# Content check: common key patterns
scan=$(echo "$files" | grep -v "^\.githooks/" || true)
if [ -n "$scan" ] && git diff --cached -U0 -- $scan 2>/dev/null | grep -E '^\+' | grep -nE '(sk-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{30,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|LOCAL_LLM_API_KEY=.+)'; then
  echo "Blocked: the diff has a string that looks like a secret."; fail=1
fi
python3 scripts/check_rules.py --staged || fail=1
if command -v gitleaks >/dev/null; then gitleaks protect --staged --no-banner || fail=1; fi
exit $fail
