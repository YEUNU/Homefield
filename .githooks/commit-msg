#!/usr/bin/env bash
# Conventional Commits 형식 검사.
head -1 "$1" | grep -qE '^(feat|fix|eval|docs|chore|exp|refactor|test)(\([a-z0-9-]+\))?!?: .{1,72}$' && exit 0
case "$(head -1 "$1")" in Merge*|Revert*|fixup!*|squash!*) exit 0;; esac
echo "커밋 메시지 형식: <유형>(<범위>): <요약>  예) feat(policy): 철수 조건 추가" >&2
exit 1
