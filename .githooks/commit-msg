#!/usr/bin/env bash
# Check Conventional Commits format. The summary must be 72 characters or fewer (UTF-8 characters).
subject=$(head -1 "$1")
case "$subject" in Merge*|Revert*|fixup!*|squash!*) exit 0;; esac
python3 - "$subject" <<'PY' && exit 0
import re, sys
s = sys.argv[1]
m = re.fullmatch(r'(feat|fix|eval|docs|chore|exp|refactor|test)(\([a-z0-9-]+\))?!?: (.+)', s)
sys.exit(0 if m and len(m.group(3)) <= 72 else 1)
PY
echo "Commit message format: <type>(<scope>): <summary, max 72 chars>  e.g. feat(policy): add withdrawal condition" >&2
exit 1
